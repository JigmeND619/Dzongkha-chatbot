# Copy this file to ".env" and fill in your own values. Never commit ".env".
OPENAI_API_KEY=your-api-key-here
# Any chat-capable model your account can use. Check https://platform.openai.com/docs/models
OPENAI_MODEL=gpt-4o
# Long random string used to sign the session cookie (optional locally)
FLASK_SECRET_KEY=change-me
